# Skopiuj do .env (Windows, dev) albo do /etc/fotofoto.env (Pi, produkcja).
# .env jest w .gitignore — nie commitujemy go.

PORT=3000

# 0.0.0.0 pozwala wejść na aplikację z telefonu w tej samej sieci Wi-Fi
# (http://192.168.x.x:3000). Wymaga przepuszczenia portu przez Windows Firewall.
HOST=0.0.0.0

# Ścieżka względna rozwiązuje się względem katalogu projektu.
# Na Pi ustawiamy bezwzględną: DATA_DIR=/srv/fotofoto/data
DATA_DIR=data

LOG_LEVEL=info

# Basic auth do /admin. Domyślne "admin"/"admin" tylko do dev-a — na Pi ustaw
# realne wartości w /etc/fotofoto.env, inaczej start wypisze ostrzeżenie w logu.
ADMIN_USER=admin
ADMIN_PASS=admin
